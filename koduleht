<!DOCTYPE html>
<html>
<head>
  <title>OpenAqua</title>
  <style>
    /* CSS styles go here */
    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      background-color: #e5e5e5;
      margin: 0;
      padding: 20px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
    }

    h1 {
      text-align: center;
      color: #a80000;
      margin-bottom: 30px;
    }

    .box {
      width: 200px;
      height: 150px;
      background-color: #ffffff;
      border: 1px solid #cccccc;
      border-radius: 5px;
      margin: 10px;
      padding: 10px;
      text-align: center;
      box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
      transition: box-shadow 0.3s ease-in-out;
    }

    .box:hover {
      box-shadow: 0 5px 10px rgba(0, 0, 0, 0.3);
    }

    h2 {
      font-size: 18px;
      color: #a80000;
      margin-bottom: 10px;
    }

    .temperature {
      font-size: 32px;
      color: #a80000;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <h1>Welcome to OpenAqua</h1>

  <div class="box">
    <h2>Temperature 1</h2>
    <div class="temperature">23°C</div>
  </div>

  <div class="box">
    <h2>Temperature 2</h2>
    <div class="temperature">19°C</div>
  </div>

  <div class="box">
    <h2>Temperature 3</h2>
    <div class="temperature">27°C</div>
  </div>
</html> 
